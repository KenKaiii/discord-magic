{
  "name": "discord-magic",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-managed Discord bot boilerplate: server-as-code, slash commands, one-command Railway deploys.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node src/index.ts",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.ts",
    "invite": "node --env-file-if-exists=.env scripts/invite.ts",
    "commands:deploy": "node --env-file-if-exists=.env scripts/deploy-commands.ts",
    "server:plan": "node --env-file-if-exists=.env scripts/server.ts plan",
    "server:apply": "node --env-file-if-exists=.env scripts/server.ts apply",
    "server:export": "node --env-file-if-exists=.env scripts/server.ts export",
    "server:pick": "node --env-file-if-exists=.env scripts/pick-server.ts",
    "server:backup": "node --env-file-if-exists=.env scripts/server.ts backup",
    "deploy": "node --env-file-if-exists=.env scripts/railway-deploy.ts",
    "logs": "railway logs --service discord-bot",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "skills:sync": "node scripts/sync-skills.ts"
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "pino-pretty": "13.2.0",
    "railway": "3.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
