# Every variable the bot needs. Copy to .env and fill in (never commit .env).
# Uncommented KEY= lines are required: `npm run doctor` checks them and `npm run deploy` copies
# them to Railway. The comment above each says where to get it. Agents: ask the user for every
# empty one in one message, using these comments, and write the answers into .env yourself.

# Bot token: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Your server's ID: Discord -> User Settings -> Advanced -> Developer Mode on,
# then right-click the server icon -> Copy Server ID
DISCORD_GUILD_ID=

# Optional
# LOG_LEVEL=info
# PORT=3000
